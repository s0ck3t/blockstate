# =============================================================================
# Blockstate (blockstate) — Enterprise 12-Factor Environment Template (AD-13)
# =============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# SECURITY INVARIANT:
#   - NEVER commit `.env` or any file containing real credentials or PII.
#   - All secret fields are loaded into `pydantic.SecretStr` by `BlockstateSettings`
#     (`src/blockstate/config.py`) so stack traces, logs, and repr() outputs
#     automatically mask values as `**********`.
#   - Pre-commit hooks (`gitleaks`, `detect-secrets`, `blockstate-pii-guard`)
#     actively scan and block any real secrets or PII before commit.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Runtime & Execution Environment
# -----------------------------------------------------------------------------
# Permitted values: development | testing | staging | production
BLOCKSTATE_ENV=development
BLOCKSTATE_APP_NAME=blockstate-enterprise-agent
BLOCKSTATE_LOG_LEVEL=INFO
# Structured JSON output to stdout (true for staging/production, false for Rich dev console)
BLOCKSTATE_LOG_JSON=false
# Default maximum conversational turns per @Stage before circuit breaking (None = unlimited)
BLOCKSTATE_DEFAULT_MAX_TURNS=5
# Maximum recursive nesting depth for PartialSlotModel schemas (AD-5)
BLOCKSTATE_MAX_SLOT_NESTING_DEPTH=8
# Maximum TaskStack pushdown depth for nested user digressions (prevents stack exhaustion)
BLOCKSTATE_MAX_TASK_STACK_DEPTH=6

# -----------------------------------------------------------------------------
# 2. Zero-Trust PIIVault & Cryptographic Key Management (AD-7)
# -----------------------------------------------------------------------------
# Enable ingress PII sanitisation (<VAULT:TYPE_NN>) before Pass 1 & LLM transmission
BLOCKSTATE_PII_VAULT_ENABLED=true
# Primary 32-byte (256-bit) base64-encoded key for AES-256-GCM SessionCheckpoint.vault_map encryption
# Generate locally via: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BLOCKSTATE_VAULT_SECRET_KEY=CHANGE_ME_GENERATE_32_BYTE_BASE64_KEY_FOR_AES256_GCM
# Optional comma-separated retired keys for zero-downtime key rotation (MultiFernet / GCM keyring)
BLOCKSTATE_VAULT_FALLBACK_KEYS=
# Deterministic HMAC-SHA256 pepper used to derive session-scoped opaque token identifiers
BLOCKSTATE_VAULT_HMAC_PEPPER=CHANGE_ME_GENERATE_32_BYTE_HMAC_PEPPER_STRING
# Built-in PII detector ruleset profile: uk_fca_gdpr | us_hipaa | global_strict
BLOCKSTATE_PII_DETECTOR_PROFILE=uk_fca_gdpr

# -----------------------------------------------------------------------------
# 3. Version 1 StorageBackend SPI & Session Leasing (AD-9)
# -----------------------------------------------------------------------------
# Canonical v1 StorageBackend drivers (`src/blockstate/ports/storage.py`):
#   memory | sqlite | postgres
# (Note: Redis, Microsoft SQL Server, and AWS DynamoDB are deferred to v1.2+
#  via the formal async StorageBackend SPI.)
BLOCKSTATE_STORAGE_BACKEND=sqlite

# 1. In-Memory driver (`InMemoryStorageBackend` — hermetic unit testing & CI/CD)
#    Requires no external DSN when BLOCKSTATE_STORAGE_BACKEND=memory

# 2. Local SQLite driver (`SQLiteStorageBackend` with PRAGMA journal_mode=WAL via aiosqlite)
#    Zero-dependency local development and edge deployments
BLOCKSTATE_SQLITE_DSN=sqlite+aiosqlite:///./.blockstate/state.db
BLOCKSTATE_SQLITE_JOURNAL_MODE=WAL

# 3. PostgreSQL driver (`PostgresStorageBackend` via SQLAlchemy[asyncio] + asyncpg)
#    Cloud production workloads (durable JSONB ACID StorageBackend & TurnLedger)
BLOCKSTATE_POSTGRES_DSN=postgresql+asyncpg://blockstate_user:CHANGE_ME_DB_PASSWORD@localhost:5432/blockstate_db
BLOCKSTATE_POSTGRES_POOL_SIZE=20
BLOCKSTATE_POSTGRES_MAX_OVERFLOW=10

# Distributed Lease & Concurrency Control (FR-19 / AD-9)
# Fail-fast lock acquisition timeout in milliseconds (raises ConcurrentSessionError / HTTP 409)
BLOCKSTATE_LEASE_WAIT_TIMEOUT_MS=2000
# Lease time-to-live (TTL) in milliseconds before automatic stale lock release
BLOCKSTATE_LEASE_TTL_MS=30000
# Background heartbeat interval in milliseconds during active tool execution
BLOCKSTATE_LEASE_HEARTBEAT_MS=10000

# -----------------------------------------------------------------------------
# 4. Tamper-Evident TurnLedger & Graceful WAL Drain (AD-8)
# -----------------------------------------------------------------------------
# Active LedgerSink drivers (comma-separated): file | postgres | s3
BLOCKSTATE_LEDGER_SINKS=file
# Local Write-Ahead Log (WAL) directory for backpressure spill and SIGTERM graceful drain
BLOCKSTATE_LEDGER_WAL_DIR=./.blockstate/wal
# Maximum in-memory ring buffer capacity per worker before spilling to local WAL
BLOCKSTATE_LEDGER_BUFFER_MAX_SIZE=10000
# Graceful shutdown drain timeout in seconds on SIGTERM / SIGINT
BLOCKSTATE_LEDGER_SHUTDOWN_DRAIN_SECONDS=10

# Optional S3 Immutable Audit Sink (Object Lock / WORM compliance)
BLOCKSTATE_LEDGER_S3_BUCKET=
BLOCKSTATE_LEDGER_S3_REGION=eu-west-2
BLOCKSTATE_LEDGER_S3_PREFIX=blockstate/turn-ledger/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# 5. Two-Pass Model Layer: Pass 1 (System-1 / SLM) & Pass 2 (LLM / Gateway) (AD-6)
# -----------------------------------------------------------------------------
# Pass 1 Intent & Slot Classifier backend: onnx_local | pydantic_ai | litellm
BLOCKSTATE_PASS1_BACKEND=onnx_local
# Hard timeout budget for Pass 1 extraction in milliseconds
BLOCKSTATE_PASS1_TIMEOUT_MS=100
# Path to local System-1 ONNX model directory (when using blockstate[local] / blockstate[onnx])
BLOCKSTATE_ONNX_MODEL_PATH=./models/modernbert-intent-slot-quantized.onnx

# Pass 2 Natural Language Renderer backend: pydantic_ai | litellm | template_only
BLOCKSTATE_PASS2_BACKEND=pydantic_ai
BLOCKSTATE_PASS2_MODEL=anthropic:claude-3-5-haiku-latest
BLOCKSTATE_PASS2_TIMEOUT_MS=5000

# Upstream Provider / Enterprise LiteLLM Gateway Credentials (SecretStr masked)
BLOCKSTATE_LITELLM_BASE_URL=
BLOCKSTATE_LITELLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# 6. Observability: OpenTelemetry GenAI 1.30 & Local Trace Replay (AD-14)
# -----------------------------------------------------------------------------
BLOCKSTATE_OTEL_ENABLED=false
BLOCKSTATE_OTEL_SERVICE_NAME=blockstate-agent-runtime
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Local developer JSONL trace file consumed by `blockstate trace --session <id>`
# Strictly receives post-PIIVault sanitised tokens only.
BLOCKSTATE_LOCAL_TRACE_ENABLED=true
BLOCKSTATE_LOCAL_TRACE_FILE=./.blockstate/traces.jsonl


